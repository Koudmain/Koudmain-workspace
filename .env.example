##
## Path to the repositories
##

# Backend app
BACKEND_PATH_FOLDER='/path/to/backend/repo'
# Inside the container
WORKDIR_BACKEND_PATH_FOLDER='/usr/src/app'

# Worker app
WORKER_PATH_FOLDER='/path/to/worker/repo'
# Inside the container
WORKDIR_WORKER_PATH_FOLDER='/usr/src/app'

# Fronted app
WEB_PATH_FOLDER='/path/to/web/repo'
# Inside the container
WORKDIR_WEB_PATH_FOLDER='/usr/src/app'

# Mobile APP's
MOBILE_PATH_FOLDER='/path/to/mobile-worker/repo'
# Inside the container
WORKDIR_MOBILE_PATH_FOLDER='/usr/src/app'

##
## Postgresql database
##
DB_USER=postgres
DB_PASSWORD=change-me
DB_NAME=koudmain
DB_HOST=db
DB_PORT=5432

##
## Redis cache
##
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me
REDIS_DB=0

##
## Postgresql test database
##
DB_TEST_USER=postgres
DB_TEST_PASSWORD=change-me
DB_TEST_NAME=koudmain_test
DB_TEST_HOST=db_test
DB_TEST_PORT=2345
DB_TEST_DOCKER_PORT=5432

##
## Backend
##
PORT=3000
JWT_ACCESS_SECRET=my-secret
JWT_REFRESH_SECRET=my-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

MAILJET_API_KEY=my-secret
MAILJET_SECRET_KEY=my-secret
MAIL_FROM_EMAIL=no-reply@votre-domaine.com
MAIL_FROM_NAME=Koudmain # optional
MAILER_TEST_ROUTE_ENABLED=true # optional

# Google Drive API credentials
GOOGLE_DRIVE_CLIENT_ID=change-me
GOOGLE_DRIVE_CLIENT_SECRET=change-me
GOOGLE_DRIVE_REDIRECT_URI=https://developers.google.com/oauthplayground
GOOGLE_DRIVE_REFRESH_TOKEN=change-me
GOOGLE_DRIVE_FOLDER_ID=change-me

# Google Map API key
GOOGLE_MAP_API_KEY=change-me

##
## Backend & Worker (shared)
##
# Secret sent by the worker in the X-Internal-Secret header to call the backend internal endpoints
INTERNAL_SERVICE_SECRET=change-me

##
## Worker
##
# Base URL used by the worker to call the backend internal endpoints (/internal/...)
BACKEND_INTERNAL_URL=http://backend:3000

# Push notifications are sent by the worker (consumer of the push-jobs Redis stream)
# Firebase Admin (push Android)
FIREBASE_SERVICE_ACCOUNT_JSON=change-me

# APNs (push iOS)
APNS_KEY=change-me
APNS_KEY_ID=change-me
APNS_TEAM_ID=change-me
APNS_BUNDLE_ID=com.koudmain.app
# true in production, false for sandbox
APNS_PRODUCTION=false

##
## Frontend
##
NEXT_PUBLIC_GOOGLE_SHEET_WEBHOOK_URL="https://script.google.com/macros/s/.../exec"

##
## Mobile worker
##

##
## Mobile client
##
